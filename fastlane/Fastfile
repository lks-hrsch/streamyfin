require "xcodeproj"

# fastlane runs lanes from fastlane/, so anchor every path at the repo root.
ROOT = File.expand_path("..", FastlaneCore::FastlaneFolder.path)

def asc_key
  # 1Password turns pasted newlines into spaces, so the key may arrive as base64.
  raw = ENV.fetch("ASC_KEY_P8")
  pem = raw.include?("BEGIN PRIVATE KEY")
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: pem ? raw : raw.gsub(/\s+/, ""),
    is_key_content_base64: !pem,
    in_house: false
  )
end

# Lanes for Android go in a `platform :android` block next to this one.
platform :ios do
  # ios/ is generated by `expo prebuild`, so these only hold after a prebuild with
  # EXPO_TV matching the target (0 for ios, 1 for tvos).
  PROJECT = File.join(ROOT, "ios/Streamyfin.xcodeproj")
  WORKSPACE = File.join(ROOT, "ios/Streamyfin.xcworkspace")
  SCHEME = "Streamyfin"
  APP_BUNDLE_ID = "de.lkshrsch.streamyfin"
  TARGETS = {
    "ios"  => { sigh: "ios",  asc: "ios",       destination: "generic/platform=iOS" },
    "tvos" => { sigh: "tvos", asc: "appletvos", destination: "generic/platform=tvOS" },
  }.freeze
  # macOS appends "-db" to the path it is given, so the ".keychain" suffix is what
  # makes the file ci-signing.keychain-db, the name the workflow cleanup deletes.
  KEYCHAIN = "ci-signing.keychain"
  SIGNABLE_PRODUCT_TYPES = %w[
    com.apple.product-type.application
    com.apple.product-type.app-extension
  ].freeze

  # The app and each extension need their own profile. Read them from the project
  # instead of hard coding, so a new extension is signed without touching this file.
  def signable_targets(project_path)
    project = Xcodeproj::Project.open(project_path)
    project.native_targets.filter_map do |target|
      next unless SIGNABLE_PRODUCT_TYPES.include?(target.product_type)

      config = target.build_configurations.find { |c| c.name == "Release" }
      bundle_id = config&.build_settings&.fetch("PRODUCT_BUNDLE_IDENTIFIER", nil)
      next if bundle_id.to_s.empty?

      { target: target.name, bundle_id: bundle_id }
    end
  end

  def import_p12(b64, password)
    path = File.join(Dir.tmpdir, "dist-#{Process.pid}.p12")
    File.binwrite(path, Base64.decode64(b64))
    import_certificate(
      certificate_path: path,
      certificate_password: password,
      keychain_name: KEYCHAIN,
      keychain_password: ENV.fetch("KC_PW"),
      log_output: false
    )
  ensure
    File.delete(path) if path && File.exist?(path)
  end

  # fastlane ios build_number target:ios
  # Prints the next TestFlight build number and exports it as IOS_BUILD_NUMBER for
  # the steps after it (app.config.ts reads it before prebuild).
  lane :build_number do |opts|
    tc = TARGETS.fetch(opts[:target])
    # initial_build_number 0 makes a first upload 1; a failed lookup raises instead
    # of silently restarting the count.
    latest = latest_testflight_build_number(
      api_key: asc_key,
      app_identifier: APP_BUNDLE_ID,
      platform: tc[:asc],
      initial_build_number: 0
    )
    next_number = latest.to_i + 1
    UI.success("Next #{opts[:target]} build number: #{next_number}")
    if ENV["GITHUB_ENV"]
      File.open(ENV["GITHUB_ENV"], "a") { |f| f.puts("IOS_BUILD_NUMBER=#{next_number}") }
    end
    next_number
  end

  # fastlane ios release target:ios [dry_run:true]
  lane :release do |opts|
    tc = TARGETS.fetch(opts[:target])
    dry = opts[:dry_run].to_s == "true"
    api_key = asc_key

    # Default too: sigh decodes profiles through the default keychain.
    # delete_keychain restores the old one.
    create_keychain(
      name: KEYCHAIN,
      password: ENV.fetch("KC_PW"),
      default_keychain: true,
      unlock: true,
      timeout: 0,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
    begin
      # codesign needs Apple's WWDR intermediates to chain the certificate to its root.
      FastlaneCore::CertChecker.install_missing_wwdr_certificates(in_keychain: FastlaneCore::Helper.keychain_path(KEYCHAIN))
      import_p12(ENV.fetch("DIST_P12_B64"), ENV.fetch("DIST_P12_PW"))
      # TEMPORARY diagnostics, drop this commit before merging.
      kc = FastlaneCore::Helper.keychain_path(KEYCHAIN).shellescape
      pem = File.join(Dir.tmpdir, "ci-dist.pem")
      bin = File.join(Dir.tmpdir, "ci-codesign-test")
      File.write(pem, `security find-certificate -c "iPhone Distribution" -p #{kc}`)
      ["security find-identity -v -p codesigning",
       "/usr/bin/openssl x509 -in #{pem} -noout -subject -issuer -enddate",
       "security find-certificate -a #{kc} | grep labl",
       "security verify-cert -c #{pem} -p codeSign -k #{kc}",
       "cp /usr/bin/true #{bin} && /usr/bin/codesign -f -s F67C39407A4238C8B5AFABE32045A0CBC65AE5E3 #{bin}",
       "/usr/bin/codesign -f -s F67C39407A4238C8B5AFABE32045A0CBC65AE5E3 --keychain #{kc} #{bin}",
       "launchctl managername; echo SECURITYSESSIONID=$SECURITYSESSIONID",
       "security list-keychains; security list-keychains -d system; security list-keychains -d common",
       "security verify-cert -c #{pem} -p codeSign",
       "security show-keychain-info #{kc}",
       "/usr/bin/codesign -f --timestamp=none -s F67C39407A4238C8B5AFABE32045A0CBC65AE5E3 #{bin}",
       "security unlock-keychain -p \"$KC_PW\" #{kc} && /usr/bin/codesign -f -s F67C39407A4238C8B5AFABE32045A0CBC65AE5E3 #{bin}",
       "security dump-trust-settings; security dump-trust-settings -d"].each do |cmd|
        UI.message("diag $ #{cmd}\n#{`#{cmd} 2>&1`}(exit #{$?.exitstatus})")
      end
      UI.user_error!("diag: stop before the archive")

      profiles = {}
      signable_targets(PROJECT).each do |t|
        get_provisioning_profile(
          api_key: api_key,
          app_identifier: t[:bundle_id],
          platform: tc[:sigh],
          output_path: File.join(ROOT, "build/profiles")
        )
        profile_name = lane_context[SharedValues::SIGH_NAME]
        profiles[t[:bundle_id]] = profile_name
        update_code_signing_settings(
          path: PROJECT,
          use_automatic_signing: false,
          team_id: ENV.fetch("APPLE_TEAM_ID"),
          targets: [t[:target]],
          bundle_identifier: t[:bundle_id],
          code_sign_identity: "Apple Distribution",
          profile_name: profile_name
        )
      end

      # CURRENT_PROJECT_VERSION stamps the extensions; the app's literal
      # CFBundleVersion was already set by prebuild from the same number.
      build_app(
        workspace: WORKSPACE,
        scheme: SCHEME,
        destination: tc[:destination],
        export_method: "app-store",
        export_team_id: ENV.fetch("APPLE_TEAM_ID"),
        export_options: { provisioningProfiles: profiles },
        xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('IOS_BUILD_NUMBER')}",
        output_directory: File.join(ROOT, "build", opts[:target].to_s),
        clean: true
      )

      unless dry
        upload_to_testflight(
          api_key: api_key,
          app_identifier: APP_BUNDLE_ID,
          app_platform: tc[:asc],
          ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
          skip_waiting_for_build_processing: true
        )
      end
    ensure
      delete_keychain(name: KEYCHAIN)
    end
  end
end
